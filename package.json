{
  "name": "tabe-pocket-sim",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Beaks and Blood: Tabe Pocket autonomous scout sim (original work by Nicolas Lanza and Grok Bot)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "summary": "tsx scripts/summary.ts",
    "soak": "tsx scripts/soak_report.ts",
    "map:gen": "tsx scripts/genmap_big.ts",
    "map:pack": "tsx scripts/packmap.ts",
    "map:png": "python3 scripts/mappng.py data/maps/tabe_big shots/map_big.png"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
